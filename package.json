    "@tarojs/react": "^3.6.34",
    "@tarojs/runtime": "^3.6.34",
    "@tarojs/shared": "^3.6.34",
    "@tarojs/taro": "^3.6.34",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@tarojs/cli": "^3.6.34",
    "@tarojs/webpack5-runner": "^3.6.34",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
